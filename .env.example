# Copie para .env e preencha. O .env já está no .gitignore.
#
# ATENÇÃO: o .env NUNCA vai para o repositório. Em produção estes valores
# vivem no GitHub: Settings > Secrets and variables > Actions.
#   - INSTAGRAM_TOKEN    -> aba "Secrets"    (é credencial)
#   - INSTAGRAM_USER_ID  -> aba "Variables"  (não é sigiloso)
#   - INSTAGRAM_HANDLE   -> aba "Variables"  (não é sigiloso)

# ---- Instagram (feed da home) --------------------------------------------
# ID da conta profissional da Elos, visto no Business Manager.
INSTAGRAM_USER_ID=17841471776917861

# @ do perfil, sem o arroba.
INSTAGRAM_HANDLE=elosnegociosimobiliarios

# Token do System User da BM da Elos, gerado com validade "Nunca".
# Ver directives/instagram_feed.md para o passo a passo.
INSTAGRAM_TOKEN=
